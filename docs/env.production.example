# ==============================================================================
# SPOREKART PRODUCTION ENVIRONMENT MANIFEST
# Vercel (Frontend) + Railway (Spring Boot) + Supabase (PostgreSQL & Storage)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SPRING BOOT & DATABASE (Railway + Supabase PostgreSQL)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.sporekart_prod
SPRING_DATASOURCE_PASSWORD=ProductionSuperSecretPassword123!
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# ------------------------------------------------------------------------------
# 2. JWT & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
APP_JWT_SECRET=c3BvcmVrYXJ0LXByb2R1Y3Rpb24tc2VjdXJlLWp3dC1zZWNyZXQta2V5LTI1Ni1iaXRzLW1pbmltdW0=
APP_JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE INTEGRATION
# ------------------------------------------------------------------------------
APP_SUPABASE_URL=https://sporekart.supabase.co
APP_SUPABASE_BUCKET=sporekart-media-prod
APP_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_key_example

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay Production)
# ------------------------------------------------------------------------------
APP_RAZORPAY_KEY_ID=rzp_live_SporekartProdKeyId
APP_RAZORPAY_KEY_SECRET=SporekartRazorpayLiveSecret
APP_RAZORPAY_WEBHOOK_SECRET=SporekartRazorpayWebhookSecret

# ------------------------------------------------------------------------------
# 5. LOGISTICS & SHIPPING (Shiprocket Production)
