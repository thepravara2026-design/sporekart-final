# =========================================================
# SPOREKART ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and supply actual development credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO THIS FILE.
# =========================================================

# =========================================================
# APPLICATION & SERVER CONFIGURATION
# =========================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================================================
# DATABASE / SUPABASE CONFIGURATION
# =========================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sporekart
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=sporekart
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# =========================================================
# JWT / SECURITY CONFIGURATION (Min 32 characters)
# =========================================================
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# =========================================================
# GOOGLE OAUTH CONFIGURATION
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# =========================================================
# SMTP / MAIL CONFIGURATION
# =========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_FROM_NAME=Sporekart Agritech

# =========================================================
# PAYMENT GATEWAY (RAZORPAY)
# =========================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =========================================================
# LOGISTICS & SHIPPING (SHIPROCKET)
# =========================================================
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external

# =========================================================
# SUPABASE STORAGE INTEGRATION
# =========================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_BUCKET=sporekart-media
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
